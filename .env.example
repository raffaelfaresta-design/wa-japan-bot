# Telegram Bot (dapat dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Groq AI — agar bot bisa menjawab pertanyaan APAPUN (dapat dari https://console.groq.com)
# Kosongkan = bot jalan mode lokal (hanya jawab dari materi 30 hari)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.6-27b

# Broadcast kosakata otomatis (menit, default 60 = 1 jam)
BROADCAST_INTERVAL_MINUTES=60

# Kirim 1 broadcast contoh 10 detik setelah bot start (0/1)
BROADCAST_ON_START=0
